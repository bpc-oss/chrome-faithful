{
  "name": "chrome-faithful",
  "version": "0.4.0",
  "type": "module",
  "description": "Faithful control of your real, logged-in Chrome profiles: MCP server + MV3 extension + authenticated localhost bridge. No copied profiles, no debug profile, no remote-debugging port, no Edge.",
  "license": "MIT",
  "author": "bpc-oss",
  "homepage": "https://github.com/bpc-oss/chrome-faithful#readme",
  "bugs": {
    "url": "https://github.com/bpc-oss/chrome-faithful/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpc-oss/chrome-faithful.git"
  },
  "keywords": [
    "chrome",
    "cdp",
    "mcp",
    "chrome-debugger",
    "browser-automation",
    "mv3",
    "codex",
    "claude",
    "multi-profile"
  ],
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    ".mcp.json",
    "bin/",
    "compat/",
    "config/local.example.json",
    "docs/CODEX_PARITY.md",
    "extension/",
    "mcpb/",
    "scripts/Install-AgentOsChromeCdp.ps1",
    "scripts/Install-AgentOsChromeExtension.ps1",
    "scripts/Private-Storage.psm1",
    "scripts/build-extension-runtime.mjs",
    "scripts/build-mcpb.mjs",
    "scripts/check-codex-parity.mjs",
    "scripts/check.mjs",
    "scripts/mcp-smoke.mjs",
    "scripts/run-unit-tests.mjs",
    "scripts/text-normalization.mjs",
    "skills/",
    "src/",
    "README.zh-CN.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:extension": "node scripts/build-extension-runtime.mjs",
    "check": "node scripts/check.mjs",
    "check:parity": "node scripts/check-codex-parity.mjs",
    "test": "node scripts/run-unit-tests.mjs",
    "start": "node src/mcp-server.mjs",
    "bridge": "node src/bridge-server.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "puppeteer-core": "25.7.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
