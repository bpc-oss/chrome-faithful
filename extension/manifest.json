{
  "manifest_version": 3,
  "name": "Agent OS Chrome CDP",
  "version": "0.3.1",
  "version_name": "0.3.1+codex.20260801130514",
  "description": "Exact-profile Chrome control through chrome.debugger without a debug profile or remote-debugging port.",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "alarms",
    "offscreen",
    "storage",
    "history",
    "downloads",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Agent OS Chrome CDP"
  }
}
